# SwiftPM
.build/
.swiftpm/

# Keep the root lockfile tracked so audited renderer dependencies stay exact.

# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
dist/
*.xcuserstate

# Generated by XcodeGen (run `make app` / `xcodegen generate` to recreate)
Councis.xcodeproj/

# macOS
.DS_Store

# Councis local runtime/worktree state
.councis/

# Legacy Intatis runtime/worktree state remains ignored during read-only
# migration and must never be committed as a compatibility fixture.
.intatis/

# Secrets / local config (never commit)
*.env
.env
secrets.json
Config.local.*
